# Local API/extractor settings. Copy this file to .env and fill in your own values.
# Never commit .env or put server secrets in frontend code.

# Required when extracting questions with Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase PostgreSQL connection strings.
# DATABASE_URL is used by the running API; DIRECT_URL is used by Prisma CLI migrations.
DATABASE_URL=
DIRECT_URL=

# Supabase project settings. Copy the URL and public key from Project Settings > API Keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only privileged key. Do not share it or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Existing private Storage bucket used by document uploads.
SUPABASE_BUCKET=mentary-question-assets

# Local development values. Set CORS_ORIGINS to the exact deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3000

# Optional PDF processing tuning; the defaults below are used if omitted.
# PDF_PAGE_BATCH_SIZE=5
# PDF_PAGE_OVERLAP=1
# PDF_BATCH_CONCURRENCY=2
